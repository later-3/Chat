{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/later-3/Chat/schemas/device-directory.schema.json",
  "title": "Chat private device directory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "devices"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "devices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/device"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#]+/?$"
        }
      }
    }
  }
}
