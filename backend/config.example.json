{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 18030,
    "frontend_origins": [
      "http://localhost:15073",
      "http://127.0.0.1:15073"
    ]
  },
  "frontend": {
    "port": 15073,
    "public_host": "localhost",
    "url": "http://localhost:15073"
  },
  "product_store": {
    "url": "sqlite+aiosqlite:///backend/.data/chat.db"
  },
  "observability": {
    "log_level": "INFO",
    "log_format": "console",
    "log_file": "backend/.data/logs/chat.jsonl",
    "log_max_bytes": 10485760,
    "log_backup_count": 5
  },
  "history": {
    "directory": ".chat-history"
  },
  "execution": {
    "workspace_root": "backend/.data/execution-workspaces"
  },
  "artifact_store": {
    "root": "backend/.data/artifacts",
    "scope_key_secret_hex": "",
    "orphan_grace_seconds": 86400
  },
  "validation": {
    "project_python": ".venv/bin/python"
  },
  "workspace_roots": [
    {
      "key": "local-projects",
      "label": "本地项目",
      "path": "/absolute/path/to/allowed/projects"
    }
  ],
  "pi_agent": {
    "enabled": false,
    "contract_version": "0.82.1",
    "node_path": "/absolute/path/to/node-22-or-newer",
    "cli_path": "/absolute/path/to/pi/packages/coding-agent/dist/cli.js",
    "source_root": "/absolute/path/to/pi",
    "session_directory": "~/.pi/agent/chat-sessions",
    "node_debug_port": null,
    "node_debug_break": false,
    "allowed_working_roots": [
      "/absolute/path/to/allowed/projects"
    ],
    "default_working_directory": "/absolute/path/to/allowed/projects",
    "gateway_origin": "http://127.0.0.1:18030"
  },
  "default_provider_id": "ark",
  "providers": [
    {
      "id": "ark",
      "label": "火山方舟",
      "enabled": true,
      "protocol": "openai_responses",
      "base_url": "https://your-ark-openai-compatible-endpoint/v1",
      "api_key": "",
      "default_model": "your-ark-model",
      "models": [
        {
          "id": "your-ark-model",
          "label": "Your ARK Model"
        }
      ],
      "capabilities": {
        "image_input": false,
        "roles": ["user", "assistant", "developer", "system"],
        "parameters": [
          {
            "key": "max_output_tokens",
            "label": "最大输出Token",
            "value_type": "integer",
            "default": 4096,
            "minimum": 1,
            "maximum": 65536
          },
          {
            "key": "temperature",
            "label": "随机性",
            "value_type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 2
          },
          {
            "key": "top_p",
            "label": "采样范围",
            "value_type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 1
          }
        ]
      }
    },
    {
      "id": "dashscope",
      "label": "阿里云百炼",
      "enabled": true,
      "protocol": "openai_chat_completions",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key": "",
      "default_model": "your-dashscope-model",
      "models": [
        {
          "id": "your-dashscope-model",
          "label": "Your DashScope Model"
        }
      ],
      "capabilities": {
        "image_input": true,
        "roles": ["user", "assistant", "developer", "system"],
        "parameters": [
          {
            "key": "max_output_tokens",
            "label": "最大输出Token",
            "value_type": "integer",
            "default": 4096,
            "minimum": 1,
            "maximum": 65536
          },
          {
            "key": "temperature",
            "label": "随机性",
            "value_type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 2
          },
          {
            "key": "top_p",
            "label": "采样范围",
            "value_type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 1
          }
        ]
      }
    },
    {
      "id": "kimi-code",
      "label": "Kimi Code",
      "enabled": true,
      "protocol": "openai_chat_completions",
      "base_url": "https://api.kimi.com/coding/v1",
      "api_key": "",
      "default_model": "k3",
      "models": [
        {
          "id": "k3",
          "label": "Kimi K3",
          "context_window": 1048576,
          "reasoning": true,
          "thinking_level_map": {
            "off": "none",
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max"
          }
        }
      ],
      "capabilities": {
        "image_input": false,
        "roles": ["user", "assistant", "system"],
        "content_types_by_role": {
          "user": ["text"],
          "assistant": ["text"],
          "system": ["text"]
        },
        "parameters": [
          {
            "key": "max_completion_tokens",
            "label": "最大输出Token",
            "value_type": "integer",
            "default": 131072,
            "minimum": 1,
            "maximum": 131072
          },
          {
            "key": "reasoning_effort",
            "label": "思考强度",
            "value_type": "enum",
            "default": "high",
            "choices": ["none", "low", "high", "max"]
          }
        ]
      }
    }
  ]
}
