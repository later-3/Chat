{
  "schemaVersion": 1,
  "id": "planning-execution",
  "name": "规划执行",
  "description": "Planner先制定计划，随后由Pi Coding Agent执行。",
  "nodes": [
    {
      "kind": "agent",
      "id": "plan",
      "name": "规划",
      "description": "Planner根据Session历史和用户请求生成计划。",
      "agentId": "planner"
    },
    {
      "kind": "agent",
      "id": "execute",
      "name": "执行",
      "description": "Pi Coding Agent结合用户请求和计划完成任务。",
      "agentId": "pi-coding-agent"
    }
  ],
  "agents": [
    {
      "id": "planner",
      "config": "./agents/planner/agent.json"
    },
    {
      "id": "pi-coding-agent",
      "config": "./agents/pi-coding-agent/agent.json"
    }
  ]
}
