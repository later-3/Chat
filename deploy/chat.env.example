# Chat生产进程。chatctl会按安装路径渲染CHAT_HOME和WORKFLOW_LOCAL_DATA_DIR。
HOST=127.0.0.1
PORT=43110
WORKFLOW_TARGET_WORLD=local
# 运行数据必须使用Chat Home绝对路径；macOS手工部署时替换为对应用户主目录。
CHAT_HOME=/home/chat/.chat
WORKFLOW_LOCAL_DATA_DIR=/home/chat/.chat/runtime/workflow-data
CHAT_PUBLIC_URL=https://chat.ai4child.asia

# Web登录默认启用。首次安装必须把占位符替换为用户自己的强密码。
CHAT_WEB_AUTH_ENABLED=1
CHAT_WEB_AUTH_USERNAME=later
CHAT_WEB_AUTH_PASSWORD=__REQUIRED_STRONG_PASSWORD__
CHAT_WEB_AUTH_SESSION_DAYS=30

# Linux安装时由chatctl生成至少32字节的随机签名密钥；不要手工复用或提交Git。
CHAT_WEB_AUTH_SESSION_SECRET=__GENERATED_BY_CHATCTL__

# Provider API Key（二选一：在这里取消注释，或配置CHAT_HOME/agent/auth.json中的OAuth）。
# 只设置实际使用的Provider；不要把包含密钥的chat.env提交Git。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
