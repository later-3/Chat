# Chat生产进程。chatctl会按安装路径渲染CHAT_HOME和WORKFLOW_LOCAL_DATA_DIR。
HOST=127.0.0.1
PORT=43110
CHAT_CHANNEL_GATEWAY_TOKEN=replace-with-at-least-32-random-characters
# First-use Long Agent provisioning; existing registry instance settings take precedence.
CHAT_NANOCLAW_GATEWAY_URL=http://127.0.0.1:3000/webhook/chat-backend
WORKFLOW_TARGET_WORLD=local
# 运行数据必须使用Chat Home绝对路径；macOS手工部署时替换为对应用户主目录。
CHAT_HOME=/home/chat/.chat
WORKFLOW_LOCAL_DATA_DIR=/home/chat/.chat/runtime/workflow-data
CHAT_PUBLIC_URL=https://chat.example.com



# Provider API Key（二选一：在这里取消注释，或配置CHAT_HOME/agent/auth.json中的OAuth）。
# 只设置实际使用的Provider；不要把包含密钥的chat.env提交Git。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
