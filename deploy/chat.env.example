# Chat生产进程
HOST=127.0.0.1
PORT=43110
WORKFLOW_TARGET_WORLD=local
CHAT_PUBLIC_URL=https://chat.ai4child.asia

# 默认账号按当前产品约定设置。公网部署后建议立即替换密码。
CHAT_WEB_AUTH_ENABLED=1
CHAT_WEB_AUTH_USERNAME=later
CHAT_WEB_AUTH_PASSWORD=123456
CHAT_WEB_AUTH_SESSION_DAYS=30

# 生产环境建议设置独立的随机签名密钥（至少32个字符）。
# CHAT_WEB_AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
