{
  "name": "@chat/dsh-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/dsh/check-distribution.mjs",
    "dev": "pnpm prepare:profile && node ../../scripts/dsh/start-web.mjs",
    "prepare:profile": "node ../../scripts/dsh/prepare-web-profile.mjs",
    "start": "pnpm prepare:profile && node ../../scripts/dsh/start-web.mjs",
    "test": "node --test ../../scripts/dsh/plugin-registry.test.mjs ../../scripts/dsh/profile-runtime.test.mjs ../../scripts/dsh/web-gateway.test.mjs ../../scripts/dsh/web-auth.test.mjs ../../scripts/e2e/dsh-real-environment.test.mjs ../../scripts/e2e/dsh-real-terminal-canary.test.mjs && TSX_TSCONFIG_PATH=../../packages/dsh-lifeos-bridge/tsconfig.json node --import tsx --test tests/*.test.mjs",
    "test:paid:planning": "node ../../scripts/ci/test-safety-gate.mjs paid --command-name=test:paid:dsh-planning --credential=DASHSCOPE_API_KEY --loader=dashscope -- node ../../scripts/e2e/run-dsh-mode.mjs planning",
    "test:paid:prompt-three-gates": "node ../../scripts/ci/test-safety-gate.mjs paid --command-name=test:paid:dsh-prompt-three-gates --credential=DASHSCOPE_API_KEY --loader=dashscope -- node ../../scripts/e2e/run-dsh-mode.mjs prompt-three-gates",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chat/dsh-lifeos-bridge": "workspace:*",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "dsh-mobile-hanui": "0.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@chat/contracts": "workspace:*",
    "@chat/realtime": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
