{
  "name": "@chat/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/check-web-public-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e:pwa": "NO_PROXY=localhost,127.0.0.1,::1 playwright test",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "12.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "workbox-window": "7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chat/domain": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10"
  }
}
