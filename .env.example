# Copy this file to backend/.env. Never commit the resulting file.

# Text model: OpenAI-compatible ARK endpoint
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=your-model
ARK_API_KEY=
ARK_SUPPORTS_IMAGE_INPUT=false

# Optional vision provider reserved for a later multimodal slice
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DASHSCOPE_VISION_MODEL=your-vision-model
DASHSCOPE_API_KEY=

# Chat runtime
CHAT_HISTORY_DIR=.chat-history
CHAT_BACKEND_HOST=127.0.0.1
CHAT_BACKEND_PORT=8030
CHAT_FRONTEND_PORT=5073
CHAT_FRONTEND_PUBLIC_HOST=localhost
CHAT_FRONTEND_URL=http://localhost:5073
CHAT_FRONTEND_ORIGINS=http://localhost:5073,http://127.0.0.1:5073

# CHAT_MODEL / CHAT_MODEL_API_KEY / CHAT_MODEL_BASE_URL may be used to override
# the ARK aliases above without changing application code.
