# Chat本地环境样例。复制为.env后填写；.env不得提交Git。
# 严禁在此文件或任何提交中写入真实Key、Workspace ID或私有地址。

# 百炼按量付费/业务空间API Key（B2起需要）。
# Token Plan / Coding Plan专用Key与Endpoint不得用于Chat后端服务。
# 缺失时服务可启动但Provider报告not ready；绝不会切换为假Provider。
DASHSCOPE_API_KEY=

# 百炼OpenAI兼容Base URL。默认华北2（北京）；
# 业务空间使用专属域名，仅允许HTTPS，启动时校验域名合同。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# VS Code的Workflow本地调试会优先使用上述环境/.env；两者都缺失时，才在本地进程内
# 安全复用既有pi dashscope Provider配置。API内的Project Intake理解Adapter也使用同一安全
# 预加载方式。无需复制Key到本仓库、命令行或VS Code配置。

# Project Resource Root Registry。浏览器只能看到rootId/displayName，不能提交任意绝对路径。
# 请把canonicalPath替换为本机真实、已授权的工作区绝对路径；PS1只进行只读观察。
# CHAT_PROJECT_ROOTS_JSON=[{"rootId":"root_chat","displayName":"Chat工作区","canonicalPath":"/absolute/path/to/Chat","enabledAdapters":["local-git-workspace.v1","project-document-manifest.v1","package-script-catalog.v1"]}]
# Project理解节点使用服务端Model Profile；默认仍复用本次验收的百炼配置。
# 换其他OpenAI-compatible模型只改以下配置，不改Project合同或前端。
# CHAT_PROJECT_MODEL_PROVIDER=bailian
# CHAT_PROJECT_MODEL_ID=qwen3.7-plus
# CHAT_PROJECT_MODEL_DISPLAY_NAME=Qwen3.7 Plus
# CHAT_PROJECT_MODEL_PROFILE_VERSION=bailian.qwen3.7-plus.v1
# CHAT_PROJECT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_PROJECT_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY

# M1固定memmy本地服务地址。主调试Compound会安全启动该服务；通常无需修改。
CHAT_MEMMY_BASE_URL=http://127.0.0.1:18960

# 远端memmy如启用Bearer鉴权，同时设置Token与非秘密凭据版本/keyId。
# 有Token却缺少revision时API/Workflow会失败关闭；revision用于发现两进程配置漂移，
# 不能填写Token或Token Hash，也不会返回浏览器。无Token的本地服务无需设置。
# CHAT_MEMMY_TOKEN=
# CHAT_MEMMY_CREDENTIAL_REVISION=memmy-key-2026-08

# Tencent MemoryCore服务端配置。VS Code主Compound会强制使用固定loopback调试身份，
# 无需填写这些值；以下变量用于单独启动API/Workflow或连接经批准的远端MemoryCore。
# 本地默认地址；远端地址必须使用HTTPS。
CHAT_TENCENT_MEMORYCORE_BASE_URL=http://127.0.0.1:18970

# Bearer只进入服务端环境，不进入浏览器、Trace、日志或Git。
CHAT_TENCENT_MEMORYCORE_TOKEN=

# service/team/user/agent属于MemoryCore隔离身份，可能包含私有租户信息，样例不提供假值。
CHAT_TENCENT_MEMORYCORE_SERVICE_ID=
CHAT_TENCENT_MEMORYCORE_TEAM_ID=
CHAT_TENCENT_MEMORYCORE_USER_ID=
CHAT_TENCENT_MEMORYCORE_AGENT_ID=

# 非秘密配置/凭据版本证据。它们用于发现API与Workflow配置漂移，不能填写Token或Token Hash。
CHAT_TENCENT_MEMORYCORE_CONFIG_REVISION=
CHAT_TENCENT_MEMORYCORE_CREDENTIAL_REVISION=

# 仅服务端持有的Runtime凭据（API私有Router与Workflow分发端点共享）。
# 通常无需填写：缺失时自动在.data/runtime/runtime-key生成随机凭据（0600）。
# 格式：rtk_<16位以上随机串>。不得提交真实值。
# CHAT_RUNTIME_KEY=

# 本地调试固定端口（任务书§8.1，通常无需修改）
CHAT_WEB_PORT=43110
CHAT_API_PORT=43111
CHAT_WORKFLOW_PORT=43112

# Trace目录（默认<仓库根>/.data/traces，无需修改）
# CHAT_TRACE_DIR=
