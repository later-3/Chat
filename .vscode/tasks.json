{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chat Debug: prepare",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/debug-environment.mjs",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat Debug: prepare NanoClaw (install + verify)",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/debug-environment.mjs",
        "prepare-nanoclaw"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat Debug: stop owned debug processes",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/debug-stop.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: verify",
      "type": "shell",
      "command": "pnpm verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Chat: check architecture entrypoints",
      "type": "shell",
      "command": "pnpm check:architecture",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: start development",
      "type": "shell",
      "command": "pnpm dev:all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: check normal services",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/chat-stop.mjs",
        "--normal",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: stop normal services",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/chat-stop.mjs",
        "--normal"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: check development and debug",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/chat-stop.mjs",
        "--debug",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Chat: stop development and debug",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/chat-stop.mjs",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
