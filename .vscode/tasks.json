{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "chat-debug:preclean",
      "type": "shell",
      "command": "node",
      "args": ["scripts/debug/preclean.mjs"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:prepare-memory",
      "type": "shell",
      "command": "pnpm",
      "args": ["memory:prepare:fixed"],
      "dependsOn": ["chat-debug:preclean"],
      "dependsOrder": "sequence",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:wait-memory",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/debug/wait-ready.mjs",
        "memmy",
        "http://127.0.0.1:18960/api/v1/health",
        "180000"
      ],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:prepare-memorycore",
      "type": "shell",
      "command": "pnpm",
      "args": ["memory:prepare:memorycore-fixed"],
      "dependsOn": ["chat-debug:preclean"],
      "dependsOrder": "sequence",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:wait-memorycore",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/debug/wait-ready.mjs",
        "Tencent MemoryCore",
        "http://127.0.0.1:18970/health",
        "180000"
      ],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:build-bundles",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@chat/workflows", "build:bundles"],
      "dependsOn": ["chat-debug:wait-memory", "chat-debug:wait-memorycore"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:wait-workflow",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/debug/wait-ready.mjs",
        "workflow",
        "http://127.0.0.1:43112/healthz",
        "30000"
      ],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:wait-runtime-dependencies",
      "type": "shell",
      "command": "node",
      "args": ["-e", "process.exit(0)"],
      "dependsOn": [
        "chat-debug:wait-memory",
        "chat-debug:wait-memorycore",
        "chat-debug:wait-workflow"
      ],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:wait-api",
      "type": "shell",
      "command": "node",
      "args": ["scripts/debug/wait-ready.mjs", "api", "http://127.0.0.1:43111/api/readyz", "30000"],
      "dependsOn": ["chat-debug:wait-runtime-dependencies"],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:start-web",
      "type": "shell",
      "command": "node",
      "args": ["scripts/debug/start-web.mjs"],
      "dependsOn": ["chat-debug:wait-api"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "chat-debug:stop",
      "type": "shell",
      "command": "node",
      "args": ["scripts/debug/stop.mjs"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
