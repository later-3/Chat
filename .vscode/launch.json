{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat：Memory（memmy）",
      "type": "node",
      "request": "launch",
      "port": 43122,
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "${workspaceFolder}/scripts/debug/register-process.mjs",
        "scripts/memory/start-fixed-memmy.mjs"
      ],
      "env": {
        "CHAT_DEBUG_ROLE": "memory",
        "CHAT_DEBUG_PORT": "18960",
        "CHAT_REPO_ROOT": "${workspaceFolder}",
        "CHAT_MEMMY_PORT": "18960",
        "CHAT_MEMMY_RUN_ROOT": "${workspaceFolder}/.data/debug/memmy",
        "CHAT_MEMMY_DB_PATH": "${workspaceFolder}/.data/debug/memmy/memory.sqlite"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "chat-debug:prepare-memory",
      "postDebugTask": "chat-debug:stop"
    },
    {
      "name": "Chat：Workflow 运行时",
      "type": "node",
      "request": "launch",
      "port": 43121,
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "${workspaceFolder}/scripts/debug/load-provider-env.mjs",
        "--import",
        "${workspaceFolder}/scripts/debug/register-process.mjs",
        "--import",
        "tsx",
        "packages/workflows/src/runtime-main.ts"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "CHAT_DEBUG_ROLE": "workflow",
        "CHAT_DEBUG_PORT": "43112",
        "CHAT_REPO_ROOT": "${workspaceFolder}",
        "CHAT_WORKFLOW_PORT": "43112"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "chat-debug:build-bundles",
      "postDebugTask": "chat-debug:stop"
    },
    {
      "name": "Chat：API",
      "type": "node",
      "request": "launch",
      "port": 43120,
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "${workspaceFolder}/scripts/debug/register-process.mjs",
        "--import",
        "tsx",
        "src/index.ts"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "CHAT_DEBUG_ROLE": "api",
        "CHAT_DEBUG_PORT": "43111",
        "CHAT_REPO_ROOT": "${workspaceFolder}",
        "PORT": "43111"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "chat-debug:wait-runtime-dependencies",
      "postDebugTask": "chat-debug:stop"
    },
    {
      "name": "Chat：Web 浏览器",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:43110/",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "chat-debug:start-web",
      "postDebugTask": "chat-debug:stop"
    }
  ],
  "compounds": [
    {
      "name": "Chat：完整后端闭环",
      "configurations": [
        "Chat：Memory（memmy）",
        "Chat：Workflow 运行时",
        "Chat：API",
        "Chat：Web 浏览器"
      ],
      "preLaunchTask": "chat-debug:preclean",
      "stopAll": true
    }
  ]
}
