// Dedicated debug ports/data. Read docs/development/debugging/README.md first.
// Repeated launches replace verified owners only; Nano launch also initializes the local lab.
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Backend",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "backend"
      ],
      "pauseForSourceMap": true,
      "sourceMapPathOverrides": {
        "src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*"
      },
      "outFiles": [
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Backend + Web",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "backend"
      ],
      "pauseForSourceMap": true,
      "sourceMapPathOverrides": {
        "src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*"
      },
      "outFiles": [
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "serverReadyAction": {
        "pattern": "Chat debug backend ready: http://127\\.0\\.0\\.1:45112",
        "action": "startDebugging",
        "name": "Debug Frontend Server",
        "killOnServerStop": true
      }
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Frontend Server",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "frontend"
      ],
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:35145",
        "action": "startDebugging",
        "name": "Debug Browser",
        "killOnServerStop": true
      }
    },
    {
      "name": "Debug Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:35145",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.data/debug/browser",
      "runtimeArgs": [
        "--no-first-run"
      ],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug NanoClaw",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "nanoclaw"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/.data/debug/nanoclaw/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Local Model",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "model"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Chat",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Chat + NanoClaw",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web",
        "Debug NanoClaw"
      ],
      "stopAll": true
    }
  ]
}
