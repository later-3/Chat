{
  // F5 使用独立开发数据；模型在该 Chat Home 中配置，不自动复制生产凭据。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Chat",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "CHAT_HOME": "${workspaceFolder}/.data/dev/chat-home" },
      "autoAttachChildProcesses": true,
      // Nitro/Workflow 子进程及 Pi dist 映射回源码。先执行 pnpm pi:prepare。
      "sourceMaps": true,
      "pauseForSourceMap": true,
      "sourceMapPathOverrides": {
        "src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*"
      },
      "outFiles": [
        "${workspaceFolder}/node_modules/.nitro/workflow/**/*.mjs",
        "${workspaceFolder}/.output/server/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/node_modules/.nitro/workflow/**/*.mjs",
        "${workspaceFolder}/.output/server/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:43112/",
        "action": "startDebugging",
        "name": "Start Chat Frontend",
        "killOnServerStop": true
      }
    },
    {
      "name": "Start Chat Frontend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:frontend", "--host", "127.0.0.1", "--port", "30145", "--strictPort"],
      // 与后端端口保持一致；版本注入仍由 run-frontend.mjs 负责。
      "env": { "CHAT_BACKEND_URL": "http://127.0.0.1:43112" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:30145",
        "uriFormat": "http://127.0.0.1:30145",
        "action": "openExternally"
      },
      "presentation": {
        "hidden": true
      }
    }
  ]
}
