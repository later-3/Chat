{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Minimal Workflow Runtime",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Trigger Minimal Pi Coding Agent Workflow",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm trigger",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Run Minimal Pi Coding Agent Workflow",
      "configurations": [
        "Minimal Workflow Runtime",
        "Trigger Minimal Pi Coding Agent Workflow"
      ],
      "stopAll": true
    }
  ]
}
