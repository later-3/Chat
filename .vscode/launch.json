// Dedicated debug ports/data. Read docs/development/debugging/environment.md first.
// Full environment keeps modules independent: replace any Run module with its Debug entry.
// stopAll=false is intentional; use pnpm debug:stop to stop the entire environment.
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Backend",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "backend"
      ],
      "pauseForSourceMap": true,
      "sourceMapPathOverrides": {
        "src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*"
      },
      "outFiles": [
        "${workspaceFolder}/.data/debug/output/server/**/*.mjs",
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/.data/debug/output/server/**/*.mjs",
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/src/workflows/**",
        "./src/workflows/**",
        "src/workflows/**",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Backend + Web",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "backend"
      ],
      "pauseForSourceMap": true,
      "sourceMapPathOverrides": {
        "src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*"
      },
      "outFiles": [
        "${workspaceFolder}/.data/debug/output/server/**/*.mjs",
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/.data/debug/output/server/**/*.mjs",
        "${workspaceFolder}/node_modules/.nitro-debug/**/*.mjs",
        "${workspaceFolder}/src/workflows/**",
        "./src/workflows/**",
        "src/workflows/**",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "serverReadyAction": {
        "pattern": "Chat debug backend ready: http://127\\.0\\.0\\.1:45112",
        "action": "startDebugging",
        "name": "Debug Frontend Server",
        "killOnServerStop": true
      }
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Frontend Server",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "frontend"
      ],
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:35145",
        "action": "startDebugging",
        "name": "Debug Browser",
        "killOnServerStop": true
      }
    },
    {
      "name": "Debug Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:35145",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.data/debug/browser",
      "runtimeArgs": [
        "--no-first-run"
      ],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug NanoClaw",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "nanoclaw"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/.data/debug/nanoclaw/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug Local Model",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "model"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Chat Debug: prepare",
      "name": "Debug TUI",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "tui"
      ],
      "pauseForSourceMap": true,
      "outFiles": [
        "${workspaceFolder}/cli/dist/**/*.js",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/cli/dist/**/*.js",
        "${workspaceFolder}/pi/packages/**/dist/**/*.js"
      ]
    },
    {
      "name": "Run Local Model",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "preLaunchTask": "Chat Debug: prepare",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "model"
      ],
      "presentation": {
        "group": "Run modules"
      }
    },
    {
      "name": "Run Backend",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "preLaunchTask": "Chat Debug: prepare",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "backend"
      ],
      "presentation": {
        "group": "Run modules"
      }
    },
    {
      "name": "Run Frontend Server",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "preLaunchTask": "Chat Debug: prepare",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "frontend"
      ],
      "presentation": {
        "group": "Run modules"
      },
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:35145",
        "action": "startDebugging",
        "name": "Run Browser",
        "killOnServerStop": true
      }
    },
    {
      "name": "Run NanoClaw",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "preLaunchTask": "Chat Debug: prepare",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "nanoclaw"
      ],
      "presentation": {
        "group": "Run modules"
      }
    },
    {
      "name": "Run TUI",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "preLaunchTask": "Chat Debug: prepare",
      "program": "${workspaceFolder}/scripts/debug-launch.mjs",
      "args": [
        "tui"
      ],
      "presentation": {
        "group": "Run modules"
      }
    },
    {
      "name": "Run Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:35145",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.data/debug/browser",
      "runtimeArgs": [
        "--no-first-run"
      ],
      "sourceMaps": true,
      "noDebug": true,
      "presentation": {
        "group": "Run modules"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Backend (full environment)",
      "configurations": [
        "Run Local Model",
        "Debug Backend",
        "Run Frontend Server",
        "Run TUI",
        "Run NanoClaw"
      ],
      "stopAll": false
    },
    {
      "name": "Run Chat (full environment)",
      "configurations": [
        "Run Local Model",
        "Run Backend",
        "Run Frontend Server",
        "Run TUI",
        "Run NanoClaw"
      ],
      "stopAll": false
    },
    {
      "name": "Debug Chat",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Chat + NanoClaw",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web",
        "Debug NanoClaw"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Chat TUI",
      "configurations": [
        "Debug Local Model",
        "Debug Backend",
        "Debug TUI"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Chat Web + TUI",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web",
        "Debug TUI"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Chat Web + TUI + NanoClaw",
      "configurations": [
        "Debug Local Model",
        "Debug Backend + Web",
        "Debug TUI",
        "Debug NanoClaw"
      ],
      "stopAll": true
    }
  ]
}
