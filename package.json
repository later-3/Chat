{
  "name": "chat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/dev/setup.mjs",
    "dev": "node scripts/dev/start.mjs",
    "dev:debug": "node scripts/dev/start.mjs --debug --instance=debug --memory=off --workbench=off",
    "dev:debug:status": "node scripts/dev/status.mjs --instance=debug",
    "dev:debug:stop": "node scripts/debug/stop.mjs --instance=debug",
    "dev:status": "node scripts/dev/status.mjs",
    "dev:stop": "node scripts/debug/stop.mjs",
    "test:dev-runtime": "node --test scripts/dev/app-runtime.test.mjs",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm test:all:deterministic",
    "test:ci-baseline": "node --test scripts/ci/*.test.mjs",
    "test:core": "node scripts/ci/test-lanes.mjs run core",
    "test:contract": "node scripts/ci/test-lanes.mjs run contract",
    "test:integration": "node scripts/ci/test-lanes.mjs run integration",
    "test:compat": "node scripts/ci/test-lanes.mjs run compat",
    "test:beta": "node scripts/ci/test-lanes.mjs run beta",
    "test:workbench-runtime": "node --test scripts/workbench/fixed-code-server.test.mjs scripts/dev/app-runtime.test.mjs scripts/dsh/profile-runtime.test.mjs",
    "test:workbench-runtime:real": "node scripts/workbench/verify-fixed-code-server-real.mjs",
    "test:browser": "pnpm test:browser:pwa-mobile && pnpm test:browser:planning && pnpm test:browser:prompt-studio && pnpm test:browser:trajectory && pnpm test:browser:project-bootstrap && pnpm test:browser:capability-governance",
    "test:browser:pwa-mobile": "node scripts/e2e/run-dsh-mode.mjs pwa",
    "test:browser:planning": "node scripts/e2e/run-dsh-mode.mjs planning-faux",
    "test:browser:prompt-studio": "node scripts/e2e/run-dsh-mode.mjs prompt-studio",
    "test:browser:trajectory": "node scripts/e2e/run-dsh-mode.mjs trajectory",
    "test:browser:project-bootstrap": "node scripts/e2e/run-dsh-mode.mjs project-bootstrap",
    "test:browser:capability-governance": "node scripts/e2e/run-dsh-mode.mjs capability-governance",
    "test:all:deterministic": "node scripts/ci/test-lanes.mjs run-all",
    "test:paid:provider:bailian": "pnpm --filter @chat/pi-runtime test:paid:provider:bailian",
    "test:paid:provider:bailian:coding": "pnpm --filter @chat/pi-runtime test:paid:provider:bailian:coding",
    "test:paid:provider:bailian:note": "pnpm --filter @chat/pi-runtime test:paid:provider:bailian:note",
    "test:paid:dsh-planning": "pnpm --filter @chat/dsh-web test:paid:planning",
    "test:paid:dsh-prompt-three-gates": "pnpm --filter @chat/dsh-web test:paid:prompt-three-gates",
    "test:external:memory:memmy": "node scripts/ci/test-safety-gate.mjs external --command-name=test:external:memory:memmy --switch=CHAT_MEMORY_REAL_TEST -- pnpm --filter @chat/api exec tsx ../../scripts/memory/verify-fixed-memmy-http.ts",
    "test:external:memory:memorycore": "node scripts/ci/test-safety-gate.mjs external --command-name=test:external:memory:memorycore --switch=CHAT_MEMORY_REAL_TEST -- pnpm --filter @chat/api exec tsx ../../scripts/memory/verify-fixed-memorycore-http.ts",
    "test:external:memory:response-drop": "node scripts/ci/test-safety-gate.mjs external --command-name=test:external:memory:response-drop --switch=CHAT_MEMORY_REAL_TEST -- pnpm --filter @chat/api exec tsx ../../scripts/memory/verify-response-drop.ts",
    "test:external:plane-ce": "node scripts/ci/test-safety-gate.mjs external --command-name=test:external:plane-ce --switch=CHAT_PLANE_CE_REAL_TEST --credential=CHAT_PLANE_CE_API_TOKEN -- pnpm --filter @chat/api exec node --import tsx ../../scripts/plane-ce/verify-real-bootstrap.ts",
    "managed-sources:prepare": "node scripts/ci/managed-sources.mjs prepare",
    "managed-sources:verify": "node scripts/ci/managed-sources.mjs verify",
    "api-surface:generate": "node scripts/ci/api-surface.mjs generate",
    "api-surface:check": "node scripts/ci/api-surface.mjs check",
    "api-surface:diff": "node scripts/ci/api-surface.mjs diff",
    "api-surface:update-baseline": "node scripts/ci/api-surface.mjs update-baseline",
    "compatibility:check": "node scripts/ci/compatibility-policy.mjs",
    "compatibility:facts:generate": "node scripts/ci/compatibility-facts.mjs generate",
    "compatibility:facts:update": "node scripts/ci/compatibility-facts.mjs update-baseline",
    "adr:check": "node scripts/ci/decision-records.mjs",
    "supply-chain:check": "node scripts/ci/supply-chain.mjs check",
    "supply-chain:audit": "node scripts/ci/supply-chain.mjs audit",
    "verify:core": "node scripts/ci/verify-core.mjs",
    "lint": "eslint .",
    "debug:trace": "pnpm --filter @chat/api exec tsx ../../packages/realtime/src/trace-cli.ts",
    "debug:preclean": "node scripts/debug/preclean.mjs",
    "debug:stop": "node scripts/debug/stop.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "debug:replay": "pnpm --filter @chat/api exec tsx src/replay-main.ts",
    "debug:runtime-integrity-scan": "pnpm --filter @chat/api exec tsx ../../scripts/dev/scan-runtime-integrity.ts",
    "dsh:plugins:list": "node scripts/dsh/manage-plugins.mjs list",
    "dsh:plugins:verify": "node scripts/dsh/manage-plugins.mjs verify",
    "dsh:plugins:check-updates": "node scripts/dsh/manage-plugins.mjs check-updates",
    "memory:prepare:fixed": "node scripts/memory/prepare-fixed-memmy.mjs",
    "workbench:prepare:code-server": "node scripts/workbench/prepare-fixed-code-server.mjs",
    "memory:prepare:memorycore-fixed": "node scripts/memory/prepare-fixed-memorycore.mjs",
    "test:memory:scripts": "node --test scripts/memory/fixed-memmy.test.mjs",
    "plane-ce:prepare": "node scripts/plane-ce/manage.mjs prepare",
    "plane-ce:config": "node scripts/plane-ce/manage.mjs config",
    "plane-ce:up": "node scripts/plane-ce/manage.mjs up",
    "plane-ce:down": "node scripts/plane-ce/manage.mjs down",
    "plane-ce:status": "node scripts/plane-ce/manage.mjs status",
    "test:plane-ce:scripts": "node --test scripts/plane-ce/manage.test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
