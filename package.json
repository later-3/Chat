{
  "name": "chat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm -r --sort test",
    "lint": "eslint .",
    "debug:trace": "pnpm --filter @chat/api exec tsx ../../packages/realtime/src/trace-cli.ts",
    "debug:preclean": "node scripts/debug/preclean.mjs",
    "debug:stop": "node scripts/debug/stop.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
