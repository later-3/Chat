{
  "name": "chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "HOST=127.0.0.1 PORT=43112 WORKFLOW_TARGET_WORLD=local WORKFLOW_LOCAL_DATA_DIR=.chat/workflow-data nitro dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "pi:install": "npm --prefix pi ci --ignore-scripts",
    "pi:hydrate-model-data": "npm --prefix pi run hydrate:model-data",
    "pi:build": "npm --prefix pi run build:offline",
    "pi:prepare": "pnpm pi:install && pnpm pi:hydrate-model-data && pnpm pi:build",
    "start": "WORKFLOW_LOCAL_DATA_DIR=.chat/workflow-data node .output/server/index.mjs",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:backend": "nitro build",
    "build:frontend": "pnpm --dir frontend build",
    "typecheck": "tsc --noEmit && pnpm --dir frontend typecheck",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "node --import ./scripts/typescript-test-loader.mjs --experimental-strip-types scripts/run-backend-tests.mjs",
    "test:frontend": "pnpm --dir frontend test",
    "test:built": "node --test scripts/built-server.test.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm test:built"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "link:./pi/packages/agent",
    "@earendil-works/pi-coding-agent": "link:./pi/packages/coding-agent",
    "@opentelemetry/api": "1.9.0",
    "mammoth": "^1.12.0",
    "nitro": "3.0.260610-beta",
    "rollup": "4.63.0",
    "workflow": "4.8.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "link:./pi/packages/ai",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "5.1.16",
      "undici": "7.29.0"
    },
    "patchedDependencies": {
      "@workflow/builders@4.1.10": "patches/@workflow__builders@4.1.10.patch"
    }
  }
}
