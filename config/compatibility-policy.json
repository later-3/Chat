{
  "schemaVersion": 2,
  "rules": [
    "read_old_write_current",
    "same_schema_literal_immutable",
    "new_write_semantics_require_new_generation",
    "read_only_legacy_cannot_expand_authority",
    "breaking_change_requires_detect_why_fix_verify_rollback",
    "breaking_change_requires_explicit_user_approval"
  ],
  "domains": [
    {
      "id": "network-contracts",
      "ownerRoots": ["packages/contracts/src", "config/api-surface.baseline.json"],
      "factSources": ["packages/contracts/src/public.ts", "config/api-surface.baseline.json"]
    },
    {
      "id": "product-store",
      "ownerRoots": ["packages/contracts/src/product-store.ts", "packages/product-store-json/src"],
      "factSources": ["packages/contracts/src/product-store.ts", "packages/product-store-json/src"]
    },
    {
      "id": "bridge-state",
      "ownerRoots": ["packages/dsh-lifeos-bridge/src/state-store.ts"],
      "factSources": ["packages/dsh-lifeos-bridge/src/state-store.ts"]
    },
    {
      "id": "workflow-run-spec",
      "ownerRoots": [
        "packages/application/src/workflow-run-spec-compiler.ts",
        "packages/contracts/src",
        "packages/product-store-json/src/json-product-store.ts",
        "packages/workflows/src"
      ],
      "factSources": [
        "packages/application/src/workflow-run-spec-compiler.ts",
        "packages/contracts/src/workflow-definition.ts",
        "packages/product-store-json/src/json-product-store.ts",
        "packages/workflows/src/configurable-planning-steps.ts",
        "packages/workflows/src/restricted-run-spec-interpreter.ts",
        "packages/workflows/src/definition-kernel-lab-steps.ts"
      ]
    },
    {
      "id": "direct-generic-journals",
      "ownerRoots": ["packages/contracts/src", "packages/pi-runtime/src"],
      "factSources": [
        "packages/contracts/src/direct-agent-runtime.ts",
        "packages/pi-runtime/src/executor-service-contract.ts",
        "packages/pi-runtime/src/direct-executor-service-contract.ts",
        "packages/pi-runtime/src/direct-executor-service-client.ts",
        "packages/pi-runtime/src/direct-executor-operation-store.ts",
        "packages/pi-runtime/src/executor-operation-store.ts",
        "packages/pi-runtime/src/executor-service-client.ts"
      ]
    },
    {
      "id": "browser-dto-events",
      "ownerRoots": ["packages/contracts/src", "packages/dsh-lifeos-bridge/src/client"],
      "factSources": [
        "packages/contracts/src/public.ts",
        "packages/contracts/src/events.ts",
        "packages/dsh-lifeos-bridge/src/client/index.tsx"
      ]
    }
  ]
}
