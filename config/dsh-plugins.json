{
  "schemaVersion": "chat-dsh-plugin-registry.v1",
  "dshVersion": "0.1.0-rc.6",
  "plugins": [
    {
      "id": "lifeos-bridge",
      "status": "enabled",
      "ownership": "chat",
      "adoption": "chat_owned",
      "packageName": "@chat/dsh-lifeos-bridge",
      "source": {
        "kind": "workspace",
        "path": "packages/dsh-lifeos-bridge",
        "version": "0.1.0"
      },
      "compatibility": {
        "dsh": ["0.1.0-rc.6"],
        "platforms": ["web"]
      },
      "capabilities": {
        "clientServices": ["conversationEvents", "slots"],
        "hostServices": ["llm", "webServer", "workspaceRegistry"],
        "networkEgress": ["CHAT_API_BASE_URL"],
        "privateDomDependency": false
      },
      "localChange": {
        "kind": "workspace",
        "location": "packages/dsh-lifeos-bridge",
        "upstreamIssue": null,
        "exitCondition": "替换DSH前端Host时删除profile bundle；Chat后端合同保持不变"
      },
      "update": {
        "trigger": "manual",
        "strategy": "chat_owned",
        "autoMerge": false
      },
      "verification": [
        "packages/dsh-lifeos-bridge/tests",
        "apps/dsh-web/e2e/dsh-planning-real.spec.ts"
      ]
    },
    {
      "id": "mobile-hanui",
      "status": "enabled",
      "ownership": "upstream",
      "adoption": "direct",
      "packageName": "dsh-mobile-hanui",
      "source": {
        "kind": "npm",
        "version": "0.2.4",
        "integrity": "sha512-NSnQbZGPOeXXOOOKMyTBSrxLJec4iMB7ktPO5fePmR1d+7AzmMJZyl9c2Gg8muiO2zI/KQ8+dlEOF9XoYJPiNQ==",
        "shasum": "791ad66795af3872ab9e6c2cefb3a4a97a369aee",
        "gitHead": "1022f058050d676cfea17ed88c1794386860a407",
        "tag": "v0.2.4",
        "repository": "https://github.com/Z-6354/dsh-mobile-hanui",
        "license": "MIT",
        "installPath": "apps/dsh-web/node_modules/dsh-mobile-hanui"
      },
      "compatibility": {
        "dsh": ["0.1.0-rc.6"],
        "platforms": ["web"]
      },
      "capabilities": {
        "clientServices": ["layout", "slots"],
        "hostServices": [],
        "networkEgress": [],
        "privateDomDependency": true
      },
      "localChange": null,
      "update": {
        "trigger": "manual",
        "strategy": "adopt_upstream_release",
        "autoMerge": false
      },
      "verification": [
        "apps/dsh-web/e2e/dsh-mobile-hanui-real.spec.ts",
        "scripts/dsh/profile-runtime.test.mjs"
      ]
    }
  ]
}
