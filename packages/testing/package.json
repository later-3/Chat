{
  "name": "@chat/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test ../../scripts/dev/app-runtime.test.mjs ../../scripts/memory/process-lifecycle.test.mjs ../../scripts/workbench/fixed-code-server.test.mjs"
  },
  "dependencies": {
    "@chat/api": "workspace:*",
    "@chat/application": "workspace:*",
    "@chat/contracts": "workspace:*",
    "@chat/domain": "workspace:*",
    "@chat/memory-runtime": "workspace:*",
    "@chat/pi-runtime": "workspace:*",
    "@chat/product-store-json": "workspace:*",
    "@chat/project-runtime": "workspace:*",
    "@chat/realtime": "workspace:*",
    "@chat/workflows": "workspace:*",
    "@hono/node-server": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
